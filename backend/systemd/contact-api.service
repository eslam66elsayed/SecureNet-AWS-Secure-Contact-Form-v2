[Unit]
Description=SecureNet Contact API
After=network.target

[Service]
User=ssm-user
WorkingDirectory=/home/ssm-user/contact-api
EnvironmentFile=/home/ssm-user/contact-api/.env
ExecStart=/home/ssm-user/contact-api/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
